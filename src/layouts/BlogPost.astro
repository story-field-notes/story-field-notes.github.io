---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  heroImage?: string;
  // 戻り先とタグ。省略時はパスから推測する（blog / tech / math）。
  // 階層の深いセクション（anime など）は呼び出し側で明示する。
  tag?: string;
  backHref?: string;
  backLabel?: string;
  // タイトルの上に出す小見出し（例: "シーズン 1 ・ 第 1 話"）
  eyebrow?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tag: tagProp,
  backHref: backHrefProp,
  backLabel: backLabelProp,
  eyebrow,
} = Astro.props;

const pathname = Astro.url.pathname;
const segments = pathname.split("/").filter(Boolean); // 例: ["math", "book-slug", "article"]
const isMath = pathname.startsWith("/math");

let fallbackHref: string;
let fallbackLabel: string;
let fallbackTag: string;

if (isMath) {
  // 数学記事は所属する参考書ページへ戻す
  fallbackHref = `/math/${segments[1]}`;
  fallbackLabel = "← 参考書へ戻る";
  fallbackTag = "数学";
} else if (pathname.startsWith("/tech")) {
  fallbackHref = "/tech";
  fallbackLabel = "← ものづくりへ戻る";
  fallbackTag = "ものづくり";
} else {
  fallbackHref = "/blog";
  fallbackLabel = "← ブログへ戻る";
  fallbackTag = "日記";
}

const backHref = backHrefProp ?? fallbackHref;
const backLabel = backLabelProp ?? fallbackLabel;
const tag = tagProp ?? fallbackTag;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main class="pop-main">
      <article class="sticker rise" style="max-width: 760px; margin: 0 auto; overflow: hidden;">

        <!-- article header -->
        <div
          style="background: var(--pop-peri); border-bottom: 3px solid var(--pop-ink); padding: 30px; text-align: center;"
        >
          <span class="pop-tag yellow">{tag}</span>
          {eyebrow && (
            <div style="font-weight: 800; font-size: 14px; margin-top: 12px;">{eyebrow}</div>
          )}
          <h1 class="pop-h1" style="font-size: clamp(28px,5vw,44px); margin-top: 14px;">{title}</h1>
          {(pubDate || updatedDate) && (
            <div style="font-weight: 800; margin-top: 8px;">
              {pubDate && <FormattedDate date={pubDate} />}
              {updatedDate && (
                <span style="font-style: italic; font-weight: 700; font-size: 14px; margin-left: 8px;">
                  (更新: <FormattedDate date={updatedDate} />)
                </span>
              )}
            </div>
          )}
          {heroImage && (
            <div style="margin-top: 22px; display: flex; justify-content: center;">
              <div
                style="background: #fff; border: 3px solid var(--pop-ink); border-radius: 20px; padding: 14px; box-shadow: var(--shadow-pop);"
              >
                <img
                  src={heroImage}
                  alt=""
                  style="max-width: 280px; max-height: 180px; object-fit: contain; display: block;"
                />
              </div>
            </div>
          )}
        </div>

        <!-- article body -->
        <div class:list={["pop-article-body", { "is-math": isMath }]}>
          <slot />
          <div style="margin-top: 32px;">
            <a href={backHref} class="pop-btn peri">{backLabel}</a>
          </div>
        </div>

      </article>
    </main>
    <Footer />
  </body>
</html>

---
import { getCollection, render } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import { SITE_TITLE } from "../../../consts";
import {
    formatYears,
    groupBySeason,
    leafSlug,
    ownerSlug,
    seriesSlug,
} from "../../../lib/anime";

export async function getStaticPaths() {
    const allSeries = await getCollection("animeSeries");
    const allEpisodes = await getCollection("animeEpisodes");
    const allCharacters = await getCollection("animeCharacters");

    return allSeries.map((series) => {
        const slug = seriesSlug(series.id);
        const seasons = groupBySeason(
            allEpisodes.filter((e) => ownerSlug(e.id) === slug),
        );
        const characters = allCharacters
            .filter((c) => ownerSlug(c.id) === slug)
            .sort((a, b) => a.data.order - b.data.order);

        return {
            params: { series: slug },
            props: { series, seasons, characters },
        };
    });
}

const { series, seasons, characters } = Astro.props;
const slug = seriesSlug(series.id);
const { title, originalTitle, region, country, studio, creator, status, genres, description, posterImage } =
    series.data;
const years = formatYears(series.data);
const { Content } = await render(series);

const episodeTotal = seasons.reduce((n, s) => n + s.items.length, 0);

// 定義リストに出すメタ情報。値のないものは行ごと落とす。
const meta: [string, string][] = [
    ["原題", originalTitle ?? ""],
    ["分類", `${region}アニメ${country ? ` / ${country}` : ""}`],
    ["制作", studio ?? ""],
    ["原作・創案", creator ?? ""],
    ["放送", [years, status].filter(Boolean).join(" / ")],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<!doctype html>
<html lang="ja">
    <head>
        <BaseHead title={`${title} — ${SITE_TITLE}`} description={description} />
    </head>
    <body>
        <Header />
        <main class="pop-main">
            <!-- series header -->
            <header class="rise" style="margin-bottom: 30px;">
                <a
                    href="/anime"
                    class="pop-tag yellow"
                    style="text-decoration: none; display: inline-block; margin-bottom: 14px;"
                >
                    ← アニメ（作品一覧）へ
                </a>

                <div style="display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap;">
                    <div style="flex: 1 1 320px; min-width: 0;">
                        <h1 class="pop-h1"><span class="hl">{title}</span></h1>

                        <dl
                            style="display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 16px 0 0; font-weight: 700;"
                        >
                            {
                                meta.map(([label, value]) => (
                                    <>
                                        <dt style="color: var(--pop-peri-deep); font-size: 14px;">
                                            {label}
                                        </dt>
                                        <dd style="margin: 0; font-size: 14px;">{value}</dd>
                                    </>
                                ))
                            }
                        </dl>

                        {
                            genres.length > 0 && (
                                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px;">
                                    {genres.map((g) => (
                                        <span class="pop-tag peri" style="font-size: 12px; padding: 3px 11px;">
                                            {g}
                                        </span>
                                    ))}
                                </div>
                            )
                        }
                    </div>

                    {
                        posterImage && (
                            <div
                                class="sticker"
                                style="padding: 12px; flex: 0 0 auto; width: 200px; border-radius: 20px;"
                            >
                                <img
                                    src={posterImage}
                                    alt={`${title}のポスター`}
                                    style="width: 100%; height: auto; object-fit: contain; display: block;"
                                />
                            </div>
                        )
                    }
                </div>
            </header>

            <!-- 作品紹介本文 -->
            <section class="sticker rise" style="overflow: hidden; margin-bottom: 34px;">
                <div class="pop-article-body">
                    <Content />
                </div>
            </section>

            <!-- キャラクター -->
            {
                characters.length > 0 && (
                    <section style="margin-bottom: 44px;">
                        <h2
                            class="pop-h2 rise"
                            style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;"
                        >
                            <span class="hl">登場キャラクター</span>
                            <span style="font-size: 15px; font-weight: 700; color: var(--pop-peri-deep);">
                                {characters.length} 人
                            </span>
                        </h2>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px;">
                            {characters.map((c, i) => (
                                <a
                                    href={`/anime/${slug}/characters/${leafSlug(c.id)}/`}
                                    class="sticker wobble rise"
                                    style={`display: flex; gap: 12px; align-items: center; padding: 14px 16px; text-decoration: none; color: var(--pop-ink); animation-delay: ${i * 0.05}s;`}
                                >
                                    <div style="width: 56px; height: 56px; flex-shrink: 0; border: 3px solid var(--pop-ink); border-radius: 50%; overflow: hidden; background: var(--pop-cream); display: flex; align-items: center; justify-content: center;">
                                        {c.data.image ? (
                                            <img
                                                src={c.data.image}
                                                alt={c.data.name}
                                                style="width: 100%; height: 100%; object-fit: cover; display: block;"
                                            />
                                        ) : (
                                            <span style="font-size: 24px;">🙂</span>
                                        )}
                                    </div>
                                    <div style="min-width: 0;">
                                        {c.data.role && (
                                            <span
                                                class="pop-tag yellow"
                                                style="font-size: 11px; padding: 2px 9px;"
                                            >
                                                {c.data.role}
                                            </span>
                                        )}
                                        <div style="font-family: var(--font-pop); font-weight: 900; font-size: 16px; margin-top: 5px;">
                                            {c.data.name}
                                        </div>
                                        {c.data.originalName && (
                                            <div style="font-size: 11px; font-weight: 700; color: var(--pop-peri-deep);">
                                                {c.data.originalName}
                                            </div>
                                        )}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            <!-- シーズンごとのエピソードレビュー -->
            {
                episodeTotal > 0 && (
                    <section>
                        <h2
                            class="pop-h2 rise"
                            style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;"
                        >
                            <span class="hl">エピソードレビュー</span>
                            <span style="font-size: 15px; font-weight: 700; color: var(--pop-peri-deep);">
                                {episodeTotal} 話
                            </span>
                        </h2>

                        {seasons.map((s) => (
                            <div style="margin-bottom: 36px;">
                                <h3
                                    class="pop-h2"
                                    style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; font-size: 22px;"
                                >
                                    <span class="pop-tag" style="background: var(--pop-peri);">
                                        シーズン {s.season}
                                    </span>
                                    {s.title && s.title !== `シーズン ${s.season}` && (
                                        <span class="hl">{s.title}</span>
                                    )}
                                </h3>
                                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
                                    {s.items.map((ep, i) => (
                                        <a
                                            href={`/anime/${slug}/episodes/${leafSlug(ep.id)}/`}
                                            class="sticker wobble rise"
                                            style={`display: block; text-decoration: none; color: var(--pop-ink); overflow: hidden; animation-delay: ${i * 0.05}s;`}
                                        >
                                            <div style="padding: 16px 20px 20px;">
                                                <span
                                                    class="pop-tag yellow"
                                                    style="font-size: 12px; padding: 3px 11px;"
                                                >
                                                    第 {ep.data.episode} 話
                                                </span>
                                                <h4 style="font-family: var(--font-pop); font-weight: 900; font-size: 19px; margin: 12px 0 2px;">
                                                    {ep.data.title}
                                                </h4>
                                                {ep.data.originalTitle && (
                                                    <div style="font-size: 12px; font-weight: 700; color: var(--pop-peri-deep); margin-bottom: 8px;">
                                                        {ep.data.originalTitle}
                                                    </div>
                                                )}
                                                <p style="font-weight: 600; font-size: 14px; margin: 8px 0 0;">
                                                    {ep.data.description}
                                                </p>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </section>
                )
            }
        </main>
        <Footer />
    </body>
</html>

---
import { getCollection } from "astro:content";
import BaseHead from "../../../../components/BaseHead.astro";
import Footer from "../../../../components/Footer.astro";
import Header from "../../../../components/Header.astro";
import PageHeading from "../../../../components/PageHeading.astro";
import { SITE_TITLE } from "../../../../consts";
import { leafSlug, ownerSlug, seriesSlug } from "../../../../lib/anime";

export async function getStaticPaths() {
    const allSeries = await getCollection("animeSeries");
    const allCharacters = await getCollection("animeCharacters");

    return allSeries.map((series) => {
        const slug = seriesSlug(series.id);
        const characters = allCharacters
            .filter((c) => ownerSlug(c.id) === slug)
            .sort((a, b) => a.data.order - b.data.order);
        return {
            params: { series: slug },
            props: { series, characters },
        };
    });
}

const { series, characters } = Astro.props;
const slug = seriesSlug(series.id);
---

<!doctype html>
<html lang="ja">
    <head>
        <BaseHead
            title={`${series.data.title} のキャラクター — ${SITE_TITLE}`}
            description={`${series.data.title} に登場するキャラクターの紹介。`}
        />
    </head>
    <body>
        <Header />
        <main class="pop-main rings">
            <a
                href={`/anime/${slug}/`}
                class="pop-tag yellow rise"
                style="text-decoration: none; display: inline-block; margin-bottom: 14px;"
            >
                ← {series.data.title} へ戻る
            </a>
            <PageHeading>
                <div>
                    <span class="pop-eyebrow">Characters</span>
                    <h1 class="pop-h1"><span class="hl">登場キャラクター</span></h1>
                    <p style="font-weight: 700; margin-top: 6px;">{series.data.title}</p>
                </div>
            </PageHeading>

            {
                characters.length === 0 ? (
                    <p style="font-weight: 700;">まだキャラクター紹介がありません。</p>
                ) : (
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 22px;">
                        {characters.map((c, i) => (
                            <a
                                href={`/anime/${slug}/characters/${leafSlug(c.id)}/`}
                                class="sticker wobble rise"
                                style={`display: flex; gap: 16px; padding: 18px 20px; text-decoration: none; color: var(--pop-ink); animation-delay: ${i * 0.05}s;`}
                            >
                                <div style="width: 84px; height: 84px; flex-shrink: 0; border: 3px solid var(--pop-ink); border-radius: 50%; overflow: hidden; background: var(--pop-cream); display: flex; align-items: center; justify-content: center;">
                                    {c.data.image ? (
                                        <img
                                            src={c.data.image}
                                            alt={c.data.name}
                                            style="width: 100%; height: 100%; object-fit: cover; display: block;"
                                        />
                                    ) : (
                                        <span style="font-size: 36px;">🙂</span>
                                    )}
                                </div>
                                <div style="min-width: 0;">
                                    {c.data.role && (
                                        <span class="pop-tag yellow" style="font-size: 11px; padding: 2px 9px;">
                                            {c.data.role}
                                        </span>
                                    )}
                                    <h2 style="font-family: var(--font-pop); font-weight: 900; font-size: 20px; margin: 8px 0 2px;">
                                        {c.data.name}
                                    </h2>
                                    {c.data.originalName && (
                                        <div style="font-size: 12px; font-weight: 700; color: var(--pop-peri-deep);">
                                            {c.data.originalName}
                                        </div>
                                    )}
                                    <p style="font-weight: 600; font-size: 14px; margin: 8px 0 0;">
                                        {c.data.description}
                                    </p>
                                    {c.data.voiceActor && (
                                        <div style="font-size: 12px; font-weight: 700; color: var(--pop-peri-deep); margin-top: 6px;">
                                            CV: {c.data.voiceActor}
                                        </div>
                                    )}
                                </div>
                            </a>
                        ))}
                    </div>
                )
            }
        </main>
        <Footer />
    </body>
</html>

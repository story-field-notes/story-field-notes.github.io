---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PageHeading from "../../components/PageHeading.astro";
import { SITE_TITLE } from "../../consts";
import {
  REGION_ORDER,
  formatYears,
  ownerSlug,
  seriesSlug,
} from "../../lib/anime";

const allSeries = (await getCollection("animeSeries")).sort(
  (a, b) => a.data.order - b.data.order,
);
const episodes = await getCollection("animeEpisodes");

// 各作品のレビュー済みエピソード数
const reviewCount = new Map<string, number>();
for (const ep of episodes) {
  const slug = ownerSlug(ep.id);
  reviewCount.set(slug, (reviewCount.get(slug) ?? 0) + 1);
}

// 海外 / 国内 でセクション分け（allSeries は order 順なので各セクション内も order 順）
const byRegion = new Map<string, typeof allSeries>();
for (const s of allSeries) {
  const region = s.data.region;
  if (!byRegion.has(region)) byRegion.set(region, []);
  byRegion.get(region)?.push(s);
}

const rank = (region: string) => {
  const i = REGION_ORDER.indexOf(region as (typeof REGION_ORDER)[number]);
  return i === -1 ? REGION_ORDER.length : i;
};
const regions = [...byRegion.entries()].sort((a, b) => rank(a[0]) - rank(b[0]));
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={`アニメ — ${SITE_TITLE}`}
      description="海外アニメ・国内アニメの作品紹介、キャラクター紹介、エピソードレビュー。"
    />
  </head>
  <body>
    <Header />
    <main class="pop-main">
      <PageHeading>
        <span class="float" style="font-size: 64px; line-height: 1;">📺</span>
        <div>
          <span class="pop-eyebrow">Anime</span>
          <h1 class="pop-h1"><span class="hl">アニメ</span></h1>
          <p style="font-weight: 700; margin-top: 6px;">
            作品紹介・キャラクター紹介・エピソードレビュー
          </p>
        </div>
      </PageHeading>

      {
        regions.map(([region, list]) => (
          <section style="margin-bottom: 44px;">
            <PageHeading size="sm">
              <h2
                class="pop-h2"
                style="display: flex; align-items: center; gap: 12px;"
              >
                <span class="hl">{region}アニメ</span>
                <span style="font-size: 15px; font-weight: 700; color: var(--pop-peri-deep);">
                  {list.length} 作品
                </span>
              </h2>
            </PageHeading>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 440px)); gap: 20px; justify-content: start;">
              {list.map((series, i) => {
                const slug = seriesSlug(series.id);
                const years = formatYears(series.data);
                return (
                  <a
                    href={`/anime/${slug}/`}
                    class="sticker wobble rise"
                    style={`display: flex; align-items: stretch; text-decoration: none; color: var(--pop-ink); min-height: 176px; animation-delay: ${i * 0.06}s;`}
                  >
                    <div style="padding: 16px 20px; flex: 1 1 auto; min-width: 0;">
                      <span
                        class="pop-tag yellow"
                        style="font-size: 12px; padding: 3px 11px;"
                      >
                        {reviewCount.get(slug) ?? 0} レビュー
                      </span>
                      <h3 style="font-family: var(--font-pop); font-weight: 900; font-size: 18px; margin: 10px 0 4px;">
                        {series.data.title}
                      </h3>
                      {series.data.originalTitle && (
                        <div style="font-size: 13px; font-weight: 700; color: var(--pop-peri-deep);">
                          {series.data.originalTitle}
                        </div>
                      )}
                      <div style="font-size: 12px; font-weight: 700; color: var(--pop-peri-deep); margin-top: 4px;">
                        {[series.data.country, years, series.data.status]
                          .filter(Boolean)
                          .join(" / ")}
                      </div>
                      {series.data.studio && (
                        <div style="font-size: 12px; font-weight: 700; color: var(--pop-peri-deep);">
                          {series.data.studio}
                        </div>
                      )}
                      {series.data.genres.length > 0 && (
                        <div style="display: flex; flex-wrap: wrap; gap: 5px; margin-top: 9px;">
                          {series.data.genres.map((g) => (
                            <span
                              class="pop-tag peri"
                              style="font-size: 11px; padding: 2px 9px;"
                            >
                              {g}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                    <div style="padding: 10px; display: flex; align-items: center; justify-content: center; width: 108px; flex-shrink: 0;">
                      {series.data.posterImage ? (
                        <img
                          src={series.data.posterImage}
                          alt={`${series.data.title}のポスター`}
                          style="width: 100%; height: 100%; object-fit: contain; display: block; filter: drop-shadow(0 2px 5px rgba(21,19,31,.28)) drop-shadow(0 0 1px rgba(21,19,31,.35));"
                        />
                      ) : (
                        <span style="font-family: var(--font-pop); font-weight: 900; font-size: 40px; opacity: .55;">
                          🎬
                        </span>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </main>
    <Footer />
  </body>
</html>

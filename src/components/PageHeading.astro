---
// 付箋＋マスキングテープ風の見出し。
// テープは .hdg の疑似要素で描いており、位置決めの基準に .fusen-3 の
// position: relative を使う。そのためこの 2 つは必ず入れ子で使うこと。
// 見出しの中身（アイコン・eyebrow・h1・リード文）は呼び出し側から渡す。

type Props = {
  /** 付箋の外側に足すインラインスタイル。下余白の調整などに使う。 */
  style?: string;
  /**
   * 付箋の大きさ。内側の余白とテープの大きさが変わる。
   * - "md": アイコン + 見出し + リード文だけのページ見出し（余白なし）
   * - "lg": メタ情報まで載せる大きい付箋（作品ページ・参考書ページ）
   * - "sm": 節見出し。テープを小さくする
   */
  size?: "md" | "lg" | "sm";
};

const { style, size = "md" } = Astro.props;
---

<div class="fusen-3" style={style}>
  <header
    class:list={[
      "rise",
      "hdg",
      { "hdg-sm": size === "sm", "hdg-lg": size === "lg" },
    ]}
    style="display: flex; align-items: center; gap: 18px; flex-wrap: wrap; width: fit-content; margin-inline: auto;"
  >
    <slot />
  </header>
</div>
